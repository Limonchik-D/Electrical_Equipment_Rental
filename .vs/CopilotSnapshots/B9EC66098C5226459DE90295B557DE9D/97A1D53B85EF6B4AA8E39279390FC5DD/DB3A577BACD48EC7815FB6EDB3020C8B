<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — EL-Rent</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Electrical_Equipment_Rental.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark-custom">
            <div class="container">
                <a class="navbar-brand-custom text-decoration-none" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon">⚡</span>
                    EL-Rent
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse" style="color:var(--text-secondary)">
                    <i class="bi bi-list fs-4"></i>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav me-auto ms-3 gap-1">
                        <li class="nav-item">
                            <a class="nav-link-custom" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house me-1"></i>Главная
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link-custom" asp-controller="Catalog" asp-action="Index">
                                <i class="bi bi-grid me-1"></i>Каталог
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link-custom" asp-controller="Home" asp-action="Map">
                                <i class="bi bi-map me-1"></i>Карта
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link-custom" asp-controller="Rental" asp-action="MyRentals">
                                    <i class="bi bi-calendar-check me-1"></i>Мои аренды
                                </a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link-custom" href="/admin">
                                        <i class="bi bi-speedometer2 me-1"></i>Панель
                                    </a>
                                </li>
                            }
                            <li class="nav-item">
                                <form method="post" action="/account/logout" class="d-inline m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="nav-link-custom btn btn-link p-0 border-0"
                                            style="background:none; font-size:.875rem; font-weight:500;">
                                        <i class="bi bi-box-arrow-right me-1"></i>Выйти
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link-custom" href="/account/login">
                                    <i class="bi bi-person me-1"></i>Войти
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn-nav-accent" href="/account/register">Регистрация</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4">
        @if (TempData["Success"] is string success)
        {
            <div class="alert-dark-success alert-dismissible fade show p-3 mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill"></i>
                <span>@success</span>
                <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert-dark-danger alert-dismissible fade show p-3 mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-circle-fill"></i>
                <span>@error</span>
                <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-dark">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="brand-icon" style="background:var(--accent);border-radius:6px;width:24px;height:24px;display:inline-flex;align-items:center;justify-content:center;font-size:.7rem;">⚡</span>
                <span class="fw-bold" style="color:var(--text-primary)">EL-Rent</span>
                <span>&copy; 2026 — Прокат электротехники</span>
            </div>
            <div class="d-flex gap-3">
                <a asp-controller="Catalog" asp-action="Index" class="text-decoration-none" style="color:var(--text-secondary);font-size:.875rem;">Каталог</a>
                <a asp-controller="Home" asp-action="Map" class="text-decoration-none" style="color:var(--text-secondary);font-size:.875rem;">Карта</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

