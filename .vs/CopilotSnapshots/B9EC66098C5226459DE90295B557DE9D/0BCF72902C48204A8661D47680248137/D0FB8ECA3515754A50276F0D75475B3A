@model Product
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Новый товар";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a href="/admin/products"
       style="background:rgba(255,255,255,.05);border:1px solid var(--border);color:var(--text-secondary);border-radius:var(--radius-sm);padding:.35rem .7rem;text-decoration:none;font-size:.85rem;">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h4 class="fw-800 mb-0" style="color:var(--text-primary)">Добавить товар</h4>
</div>

<div class="card-dark p-4" style="max-width:600px">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="mb-3 p-3 rounded"
             style="background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.25);color:#fca5a5;font-size:.875rem;"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label-dark">Название</label>
            <input asp-for="Name" class="form-control-dark w-100" />
            <span asp-validation-for="Name" style="color:#fca5a5;font-size:.8rem;"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label-dark">Описание</label>
            <textarea asp-for="Description" class="form-control-dark w-100" rows="3"></textarea>
        </div>

        <div class="row g-3 mb-3">
            <div class="col">
                <label asp-for="PricePerHour" class="form-label-dark">Цена за час (₽)</label>
                <input asp-for="PricePerHour" class="form-control-dark w-100" type="number" step="0.01" />
                <span asp-validation-for="PricePerHour" style="color:#fca5a5;font-size:.8rem;"></span>
            </div>
            <div class="col">
                <label asp-for="DepositAmount" class="form-label-dark">Залог (₽)</label>
                <input asp-for="DepositAmount" class="form-control-dark w-100" type="number" step="0.01" />
                <span asp-validation-for="DepositAmount" style="color:#fca5a5;font-size:.8rem;"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label-dark">Категория</label>
            <select asp-for="CategoryId" class="form-select-dark" asp-items="ViewBag.Categories">
                <option value="">— Выберите —</option>
            </select>
            <span asp-validation-for="CategoryId" style="color:#fca5a5;font-size:.8rem;"></span>
        </div>

        <div class="mb-4 d-flex align-items-center gap-2">
            <input asp-for="IsActive" class="form-check-input" style="background:var(--bg-elevated);border-color:var(--border);" />
            <label asp-for="IsActive" style="color:var(--text-secondary);font-size:.875rem;">Активен (виден в каталоге)</label>
        </div>

        <button type="submit" class="btn-accent btn px-4">Сохранить</button>
    </form>
</div>
