@model IEnumerable<Rental>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Аренды";
    var currentStatus = ViewBag.Status as RentalStatus?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">📋 Аренды <span class="badge bg-secondary fs-6">@Model.Count()</span></h4>
</div>

<div class="mb-3 d-flex gap-2 flex-wrap">
    <a href="/admin/rentals" class="btn btn-sm @(currentStatus == null ? "btn-dark" : "btn-outline-secondary")">Все</a>
    <a href="/admin/rentals?status=Pending" class="btn btn-sm @(currentStatus == RentalStatus.Pending ? "btn-warning text-dark" : "btn-outline-warning")">Ожидают</a>
    <a href="/admin/rentals?status=Active" class="btn btn-sm @(currentStatus == RentalStatus.Active ? "btn-success" : "btn-outline-success")">Активные</a>
    <a href="/admin/rentals?status=Completed" class="btn btn-sm @(currentStatus == RentalStatus.Completed ? "btn-secondary" : "btn-outline-secondary")">Завершённые</a>
    <a href="/admin/rentals?status=Cancelled" class="btn btn-sm @(currentStatus == RentalStatus.Cancelled ? "btn-danger" : "btn-outline-danger")">Отменённые</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Клиент</th>
                    <th>Техника</th>
                    <th>Точка получения</th>
                    <th>Оформлено</th>
                    <th>Статус</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    var badge = r.Status switch
                    {
                        RentalStatus.Pending => "warning",
                        RentalStatus.Active => "success",
                        RentalStatus.Completed => "secondary",
                        _ => "danger"
                    };
                    <tr>
                        <td class="text-muted small">@r.Id</td>
                        <td>@r.User?.FullName<br /><small class="text-muted">@r.User?.Email</small></td>
                        <td>@r.ProductUnit?.Product?.Name<br /><small class="text-muted">@r.ProductUnit?.SerialNumber</small></td>
                        <td>@r.StartLocation?.Name</td>
                        <td class="small">@r.CreatedAt.ToLocalTime().ToString("dd.MM.yy HH:mm")</td>
                        <td><span class="badge bg-@badge">@r.Status</span></td>
                        <td><a href="/admin/rentals/@r.Id" class="btn btn-sm btn-outline-primary">Открыть</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
