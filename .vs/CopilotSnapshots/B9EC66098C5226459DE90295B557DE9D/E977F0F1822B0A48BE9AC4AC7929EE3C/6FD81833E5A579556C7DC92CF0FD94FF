@using System.Text.Json
@model IEnumerable<Location>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Точки стоянки";
    var jsonOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var locJson = JsonSerializer.Serialize(
        Model.Select(l => new { l.Id, l.Name, l.Address, l.Latitude, l.Longitude, l.IsActive }),
        jsonOpts);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-800 mb-0" style="color:var(--text-primary)">Точки стоянки</h4>
        <p class="mb-0 text-secondary-custom" style="font-size:.875rem;">@Model.Count() точек</p>
    </div>
    <a href="/admin/locations/create" class="btn-accent btn px-4 d-flex align-items-center gap-2">
        <i class="bi bi-plus-lg"></i>Добавить точку
    </a>
</div>

<div class="row g-4">
    <div class="col-md-5">
        <div class="card-dark overflow-hidden">
            <div class="table-responsive">
                <table class="table-dark-custom table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Название</th>
                            <th>Техники</th>
                            <th>Статус</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="locTableBody">
                        @foreach (var loc in Model)
                        {
                            <tr data-loc-id="@loc.Id" class="loc-row" style="cursor:pointer;transition:background .15s;">
                                <td>
                                    <div style="color:var(--text-primary);font-weight:600;">
                                        <i class="bi bi-geo-alt me-1" style="color:var(--accent);font-size:.8rem;"></i>@loc.Name
                                    </div>
                                    <div style="color:var(--text-secondary);font-size:.78rem;">@loc.Address</div>
                                </td>
                                <td style="color:var(--text-primary);">@loc.Units.Count</td>
                                <td>
                                    @if (loc.IsActive)
                                    {
                                        <span class="px-2 py-1 rounded-pill" style="background:rgba(34,197,94,.12);color:#86efac;font-size:.75rem;font-weight:600;">Активна</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-1 rounded-pill" style="background:rgba(148,163,184,.1);color:var(--text-secondary);font-size:.75rem;font-weight:600;">Скрыта</span>
                                    }
                                </td>
                                <td class="text-end" onclick="event.stopPropagation()">
                                    <a href="/admin/locations/edit/@loc.Id"
                                       style="background:rgba(99,102,241,.12);color:var(--accent);border-radius:6px;padding:.3rem .65rem;text-decoration:none;font-size:.8rem;font-weight:600;margin-right:.3rem;display:inline-block;">Ред.</a>
                                    <form asp-action="Delete" asp-route-id="@loc.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Скрыть точку?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                style="background:transparent;color:#fca5a5;border:1px solid rgba(239,68,68,.3);border-radius:6px;padding:.25rem .6rem;font-size:.8rem;cursor:pointer;">✕</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div id="adminMap" style="height:420px;border-radius:var(--radius);border:1px solid var(--border);"></div>
    </div>
</div>

@section Scripts {
<script>
    var map = L.map('adminMap').setView([47.7631, 29.6383], 13);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap'
    }).addTo(map);

    var locations = @Html.Raw(locJson);
    var markersMap = {};

    var defaultIcon = L.divIcon({
        className: '',
        html: '<div style="width:14px;height:14px;border-radius:50%;background:#6366f1;border:2px solid #fff;box-shadow:0 0 0 3px rgba(99,102,241,.35);"></div>',
        iconSize: [14, 14],
        iconAnchor: [7, 7],
        popupAnchor: [0, -10]
    });
    var activeIcon = L.divIcon({
        className: '',
        html: '<div style="width:18px;height:18px;border-radius:50%;background:#22c55e;border:2px solid #fff;box-shadow:0 0 0 4px rgba(34,197,94,.4);"></div>',
        iconSize: [18, 18],
        iconAnchor: [9, 9],
        popupAnchor: [0, -12]
    });

    locations.forEach(function(loc) {
        var marker = L.marker([loc.latitude, loc.longitude], { icon: defaultIcon })
            .addTo(map)
            .bindPopup(
                '<b style="color:#e2e8f0">📍 ' + loc.name + '</b>' +
                '<br><span style="color:#94a3b8;font-size:.82rem;">' + loc.address + '</span>' +
                (loc.isActive ? '' : '<br><em style="color:#f59e0b;font-size:.78rem;">Скрыта</em>')
            );
        markersMap[loc.id] = { marker: marker, lat: loc.latitude, lng: loc.longitude };
    });

    var activeRow = null;

    document.querySelectorAll('.loc-row').forEach(function(row) {
        row.addEventListener('click', function() {
            var id = parseInt(row.dataset.locId);
            var entry = markersMap[id];
            if (!entry) return;

            // Снять подсветку с прошлой строки и вернуть стандартную иконку
            if (activeRow && activeRow !== row) {
                activeRow.style.background = '';
                var prevId = parseInt(activeRow.dataset.locId);
                if (markersMap[prevId]) markersMap[prevId].marker.setIcon(defaultIcon);
            }

            // Подсветить выбранную строку
            row.style.background = 'rgba(99,102,241,.1)';
            activeRow = row;

            // Изменить иконку на «активную»
            entry.marker.setIcon(activeIcon);

            // Плавно центрировать карту и открыть popup
            map.flyTo([entry.lat, entry.lng], 16, { duration: 0.6 });
            entry.marker.openPopup();
        });
    });
</script>
}
