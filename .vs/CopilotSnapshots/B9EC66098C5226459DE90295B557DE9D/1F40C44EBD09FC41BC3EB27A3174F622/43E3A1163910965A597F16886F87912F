@model Product
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Экземпляры — " + Model.Name;
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a href="/admin/products" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
    <h4 class="mb-0">Экземпляры: @Model.Name</h4>
</div>

<div class="row g-4">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Серийный номер</th>
                            <th>Статус</th>
                            <th>Точка стоянки</th>
                            <th>Добавлен</th>
                            <th>Изменить статус</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var unit in Model.Units)
                        {
                            var statusBadge = unit.Status switch
                            {
                                UnitStatus.Available => "success",
                                UnitStatus.Rented => "primary",
                                UnitStatus.Repair => "warning",
                                UnitStatus.Retired => "secondary",
                                _ => "secondary"
                            };
                            var statusLabel = unit.Status switch
                            {
                                UnitStatus.Available => "Свободен",
                                UnitStatus.Rented => "В аренде",
                                UnitStatus.Repair => "Ремонт",
                                UnitStatus.Retired => "Списан",
                                _ => unit.Status.ToString()
                            };
                            <tr>
                                <td class="fw-semibold">@unit.SerialNumber</td>
                                <td><span class="badge bg-@statusBadge">@statusLabel</span></td>
                                <td>@(unit.CurrentLocation?.Name ?? "—")</td>
                                <td class="small text-muted">@unit.AddedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                                <td>
                                    <form asp-action="ChangeUnitStatus" method="post" class="d-flex gap-1">
                                        <input type="hidden" name="unitId" value="@unit.Id" />
                                        <input type="hidden" name="productId" value="@Model.Id" />
                                        <select name="status" class="form-select form-select-sm" style="width:120px">
                                            @foreach (var s in Enum.GetValues<UnitStatus>())
                                            {
                                                <option value="@s" selected="@(unit.Status == s)">@s</option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-outline-primary">OK</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">Добавить экземпляр</div>
            <div class="card-body">
                <form asp-action="AddUnit" asp-route-productId="@Model.Id" method="post">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Серийный номер</label>
                        <input type="text" name="serialNumber" class="form-control form-control-sm"
                               placeholder="SN-XXX-001" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Точка стоянки</label>
                        <select name="locationId" class="form-select form-select-sm" asp-items="ViewBag.Locations">
                            <option value="">— Не указано —</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-success btn-sm w-100">Добавить</button>
                </form>
            </div>
        </div>
    </div>
</div>
