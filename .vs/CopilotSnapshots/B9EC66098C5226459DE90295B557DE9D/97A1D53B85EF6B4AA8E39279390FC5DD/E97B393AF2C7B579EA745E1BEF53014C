@model RentalCreateViewModel
@{
    ViewData["Title"] = "Оформить аренду";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="d-flex align-items-center gap-2 mb-4">
            <div style="width:3px;height:24px;background:var(--accent);border-radius:2px;"></div>
            <h4 class="fw-800 mb-0" style="color:var(--text-primary)">Оформить аренду</h4>
        </div>

        <!-- Product info -->
        <div class="card-dark p-4 mb-4">
            <p class="text-secondary-custom mb-2" style="font-size:.75rem;text-transform:uppercase;letter-spacing:.05em;font-weight:700;">Выбранная техника</p>
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-700" style="color:var(--text-primary);font-size:1.05rem;">@Model.ProductName</div>
                    <div style="color:var(--text-secondary);font-size:.85rem;margin-top:.2rem;">
                        <i class="bi bi-cpu me-1"></i>S/N: @Model.SerialNumber
                    </div>
                </div>
                <div class="text-end">
                    <div class="fw-800" style="color:var(--accent);font-size:1.2rem;">@Model.PricePerHour ₽/ч</div>
                    <div style="color:var(--text-secondary);font-size:.75rem;">Залог: @Model.DepositAmount ₽</div>
                </div>
            </div>
        </div>

        <!-- Form -->
        <form asp-action="Create" method="post">
            <input asp-for="ProductUnitId" type="hidden" />
            <input asp-for="ProductName" type="hidden" />
            <input asp-for="SerialNumber" type="hidden" />
            <input asp-for="PricePerHour" type="hidden" />
            <input asp-for="DepositAmount" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="alert-dark-danger p-3 rounded-custom mb-3"></div>

            <div class="mb-4">
                <label asp-for="StartLocationId" class="form-label-dark"></label>
                <select asp-for="StartLocationId" class="form-select-dark"
                        asp-items="@(new SelectList(Model.Locations, "Id", "Name"))">
                    <option value="">— Выберите точку выдачи —</option>
                </select>
                <span asp-validation-for="StartLocationId" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="PlannedEndAt" class="form-label-dark"></label>
                <input asp-for="PlannedEndAt" type="datetime-local" class="form-control-dark"
                       min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                <span asp-validation-for="PlannedEndAt" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Notes" class="form-label-dark"></label>
                <textarea asp-for="Notes" class="form-control-dark" rows="2"
                          placeholder="Необязательно — уточните пожелания"></textarea>
            </div>

            <div class="alert-dark-info p-3 rounded-custom mb-4 d-flex gap-2">
                <i class="bi bi-info-circle mt-1 flex-shrink-0"></i>
                <span style="font-size:.875rem;">После оформления заявки менеджер подтвердит аренду и выдаст технику.</span>
            </div>

            <div class="d-flex gap-3">
                <button type="submit" class="btn-accent btn px-4 py-2 d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle"></i> Оформить аренду
                </button>
                <a asp-controller="Catalog" asp-action="Index"
                   class="btn-outline-accent btn px-4 py-2">Назад</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

