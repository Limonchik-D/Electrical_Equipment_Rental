@model Product
@{
    ViewData["Title"] = Model.Name;
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Catalog" asp-action="Index">Каталог</a></li>
        <li class="breadcrumb-item"><a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="@Model.CategoryId">@Model.Category.Name</a></li>
        <li class="breadcrumb-item active">@Model.Name</li>
    </ol>
</nav>

<div class="row">
    <div class="col-md-8">
        <h2>@Model.Name</h2>
        <span class="badge bg-secondary mb-2">@Model.Category.Name</span>
        <p class="text-muted mt-2">@Model.Description</p>

        <div class="row g-3 my-3">
            <div class="col-6 col-md-3">
                <div class="card text-center border-0 bg-light">
                    <div class="card-body py-3">
                        <div class="fs-4 fw-bold text-primary">@Model.PricePerHour ₽</div>
                        <small class="text-muted">за час</small>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card text-center border-0 bg-light">
                    <div class="card-body py-3">
                        <div class="fs-4 fw-bold text-warning">@Model.DepositAmount ₽</div>
                        <small class="text-muted">залог</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<hr />
<h5 class="mb-3">Доступные экземпляры</h5>

@if (!Model.Units.Any())
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle me-2"></i>
        Сейчас нет свободных экземпляров. Попробуйте позже.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-3">
        @foreach (var unit in Model.Units)
        {
            <div class="col">
                <div class="card border-0 shadow-sm">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-semibold"><i class="bi bi-cpu me-1"></i>S/N: @unit.SerialNumber</div>
                            @if (unit.CurrentLocation != null)
                            {
                                <small class="text-muted"><i class="bi bi-geo-alt me-1"></i>@unit.CurrentLocation.Name</small>
                            }
                        </div>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Rental" asp-action="Create" asp-route-unitId="@unit.Id"
                               class="btn btn-success btn-sm">
                                <i class="bi bi-cart-plus me-1"></i>Арендовать
                            </a>
                        }
                        else
                        {
                            <a href="/account/login" class="btn btn-outline-primary btn-sm">Войти для аренды</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
