@model RentalCreateViewModel
@{
    ViewData["Title"] = "Оформить аренду";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <h2 class="mb-4">Оформить аренду</h2>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <h6 class="text-muted mb-1">Выбранная техника</h6>
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fw-bold fs-5">@Model.ProductName</span>
                        <span class="text-muted ms-2">S/N: @Model.SerialNumber</span>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-primary fs-6">@Model.PricePerHour ₽/ч</span>
                        <br /><small class="text-muted">Залог: @Model.DepositAmount ₽</small>
                    </div>
                </div>
            </div>
        </div>

        <form asp-action="Create" method="post">
            <input asp-for="ProductUnitId" type="hidden" />
            <input asp-for="ProductName" type="hidden" />
            <input asp-for="SerialNumber" type="hidden" />
            <input asp-for="PricePerHour" type="hidden" />
            <input asp-for="DepositAmount" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="mb-3">
                <label asp-for="StartLocationId" class="form-label fw-semibold"></label>
                <select asp-for="StartLocationId" class="form-select"
                        asp-items="@(new SelectList(Model.Locations, "Id", "Name"))">
                    <option value="">— Выберите точку —</option>
                </select>
                <span asp-validation-for="StartLocationId" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PlannedEndAt" class="form-label fw-semibold"></label>
                <input asp-for="PlannedEndAt" type="datetime-local" class="form-control"
                       min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                <span asp-validation-for="PlannedEndAt" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Notes" class="form-label fw-semibold"></label>
                <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Необязательно"></textarea>
            </div>

            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                После оформления заявки менеджер свяжется с вами для подтверждения. Аренда начинается с момента выдачи техники.
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success px-4">
                    <i class="bi bi-check-circle me-1"></i>Оформить аренду
                </button>
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-secondary">Назад</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
