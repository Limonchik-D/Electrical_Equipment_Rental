@model Rental
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Аренда #" + Model.Id;
    var locations = ViewBag.Locations as IEnumerable<Location> ?? Enumerable.Empty<Location>();
    var (sc, sb, sl) = Model.Status switch
    {
        RentalStatus.Pending   => ("#fcd34d", "rgba(245,158,11,.12)", "Ожидает"),
        RentalStatus.Active    => ("#86efac", "rgba(34,197,94,.12)",   "Активна"),
        RentalStatus.Completed => ("var(--text-secondary)", "rgba(148,163,184,.08)", "Завершена"),
        _                      => ("#fca5a5", "rgba(239,68,68,.12)",   "Отменена")
    };
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a href="/admin/rentals"
       style="width:36px;height:36px;background:rgba(255,255,255,.06);color:var(--text-secondary);border-radius:8px;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;transition:all .2s;"
       onmouseover="this.style.background='rgba(255,255,255,.1)';this.style.color='var(--text-primary)'"
       onmouseout="this.style.background='rgba(255,255,255,.06)';this.style.color='var(--text-secondary)'">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h4 class="fw-800 mb-0" style="color:var(--text-primary)">Аренда #@Model.Id</h4>
    <span class="px-3 py-1 rounded-pill fw-600" style="background:@sb;color:@sc;font-size:.82rem;">@sl</span>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card-dark p-4 h-100">
            <p class="text-secondary-custom fw-700 mb-3" style="font-size:.75rem;text-transform:uppercase;letter-spacing:.05em;">Детали аренды</p>
            <dl class="row mb-0" style="--bs-gutter-x:0;row-gap:.6rem;">
                <dt class="col-5 text-secondary-custom" style="font-size:.85rem;">Клиент</dt>
                <dd class="col-7">
                    <div style="color:var(--text-primary);font-weight:600;font-size:.875rem;">@Model.User?.FullName</div>
                    <div style="color:var(--text-secondary);font-size:.78rem;">@Model.User?.Email</div>
                </dd>

                <dt class="col-5 text-secondary-custom" style="font-size:.85rem;">Техника</dt>
                <dd class="col-7">
                    <div style="color:var(--text-primary);font-weight:600;font-size:.875rem;">@Model.ProductUnit?.Product?.Name</div>
                    <div style="color:var(--text-secondary);font-size:.78rem;">S/N: @Model.ProductUnit?.SerialNumber</div>
                </dd>

                <dt class="col-5 text-secondary-custom" style="font-size:.85rem;">Точка получения</dt>
                <dd class="col-7" style="color:var(--text-primary);font-size:.875rem;">@Model.StartLocation?.Name</dd>

                <dt class="col-5 text-secondary-custom" style="font-size:.85rem;">Оформлено</dt>
                <dd class="col-7" style="color:var(--text-primary);font-size:.875rem;">@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>

                @if (Model.StartedAt.HasValue)
                {
                    <dt class="col-5 text-secondary-custom" style="font-size:.85rem;">Выдано</dt>
                    <dd class="col-7" style="color:var(--text-primary);font-size:.875rem;">@Model.StartedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>
                }

                <dt class="col-5 text-secondary-custom" style="font-size:.85rem;">Плановый возврат</dt>
                <dd class="col-7" style="color:var(--text-primary);font-size:.875rem;">@(Model.PlannedEndAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—")</dd>

                @if (Model.ActualEndAt.HasValue)
                {
                    <dt class="col-5 text-secondary-custom" style="font-size:.85rem;">Фактический возврат</dt>
                    <dd class="col-7" style="color:var(--text-primary);font-size:.875rem;">@Model.ActualEndAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>
                }

                <dt class="col-5 text-secondary-custom" style="font-size:.85rem;">Ставка</dt>
                <dd class="col-7" style="color:var(--accent);font-weight:700;font-size:.875rem;">@Model.RatePerHour ₽/ч</dd>

                <dt class="col-5 text-secondary-custom" style="font-size:.85rem;">Залог</dt>
                <dd class="col-7" style="color:var(--text-primary);font-size:.875rem;">@Model.DepositAmount ₽</dd>

                @if (Model.TotalAmount.HasValue)
                {
                    <dt class="col-5 text-secondary-custom" style="font-size:.85rem;">Итого</dt>
                    <dd class="col-7" style="color:var(--text-primary);font-weight:700;font-size:.875rem;">@Model.TotalAmount ₽</dd>
                }

                @if (Model.FineAmount.HasValue && Model.FineAmount > 0)
                {
                    <dt class="col-5 text-secondary-custom" style="font-size:.85rem;">Штраф</dt>
                    <dd class="col-7" style="color:#fca5a5;font-weight:700;font-size:.875rem;">@Model.FineAmount ₽</dd>
                }

                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <dt class="col-5 text-secondary-custom" style="font-size:.85rem;">Примечание</dt>
                    <dd class="col-7" style="color:var(--text-primary);font-size:.875rem;">@Model.Notes</dd>
                }
            </dl>
        </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card-dark p-4">
            <p class="text-secondary-custom fw-700 mb-3" style="font-size:.75rem;text-transform:uppercase;letter-spacing:.05em;">Действия</p>
            <div class="d-flex flex-column gap-3">
                @if (Model.Status == RentalStatus.Pending)
                {
                    <form asp-action="Activate" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn w-100 py-2 fw-600 d-flex align-items-center justify-content-center gap-2"
                                style="background:rgba(34,197,94,.15);color:#86efac;border:1px solid rgba(34,197,94,.3);border-radius:8px;transition:all .2s;"
                                onmouseover="this.style.background='rgba(34,197,94,.25)'"
                                onmouseout="this.style.background='rgba(34,197,94,.15)'">
                            <i class="bi bi-play-circle"></i>Подтвердить и выдать технику
                        </button>
                    </form>
                    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn w-100 py-2 fw-600"
                                style="background:transparent;color:#fca5a5;border:1px solid rgba(239,68,68,.3);border-radius:8px;transition:all .2s;"
                                onmouseover="this.style.background='rgba(239,68,68,.12)'"
                                onmouseout="this.style.background='transparent'"
                                onclick="return confirm('Отменить аренду?')">Отменить аренду</button>
                    </form>
                }

                @if (Model.Status == RentalStatus.Active)
                {
                    <form asp-action="Complete" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label-dark">Точка возврата</label>
                            <select name="endLocationId" class="form-select-dark">
                                <option value="">— Выберите точку —</option>
                                @foreach (var loc in locations)
                                {
                                    <option value="@loc.Id">@loc.Name</option>
                                }
                            </select>
                        </div>
                        <button type="submit" class="btn-accent btn w-100 py-2 fw-600 d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-check-circle"></i>Завершить и рассчитать
                        </button>
                    </form>
                }

                @if (Model.Status == RentalStatus.Completed || Model.Status == RentalStatus.Cancelled)
                {
                    <div class="text-center py-3">
                        <i class="bi bi-check-circle-fill" style="font-size:2rem;color:var(--text-secondary);"></i>
                        <p class="mt-2 text-secondary-custom" style="font-size:.875rem;">Аренда закрыта</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
