@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Дашборд";
    var recentRentals = ViewBag.RecentRentals as IEnumerable<Rental> ?? Enumerable.Empty<Rental>();
}

<h4 class="mb-4">📊 Дашборд</h4>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body">
                <div class="fs-2 fw-bold text-primary">@ViewBag.AvailableUnits</div>
                <div class="small text-muted">Свободная техника</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body">
                <div class="fs-2 fw-bold text-success">@ViewBag.ActiveRentals</div>
                <div class="small text-muted">Активных аренд</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body">
                <div class="fs-2 fw-bold text-warning">@ViewBag.PendingRentals</div>
                <div class="small text-muted">Ожидают выдачи</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body">
                <div class="fs-2 fw-bold text-danger">@ViewBag.ActiveRepairs</div>
                <div class="small text-muted">На ремонте</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 bg-light">
            <div class="card-body d-flex justify-content-between">
                <span class="text-muted">Всего товаров</span>
                <strong>@ViewBag.ProductsCount</strong>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 bg-light">
            <div class="card-body d-flex justify-content-between">
                <span class="text-muted">Экземпляров техники</span>
                <strong>@ViewBag.UnitsCount</strong>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 bg-light">
            <div class="card-body d-flex justify-content-between">
                <span class="text-muted">Пользователей</span>
                <strong>@ViewBag.UsersCount</strong>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold">Последние заявки на аренду</div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Клиент</th>
                    <th>Техника</th>
                    <th>Дата</th>
                    <th>Статус</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in recentRentals)
                {
                    var badge = r.Status switch
                    {
                        RentalStatus.Pending => "warning",
                        RentalStatus.Active => "success",
                        RentalStatus.Completed => "secondary",
                        _ => "danger"
                    };
                    <tr>
                        <td>@r.Id</td>
                        <td>@r.User?.FullName</td>
                        <td>@r.ProductUnit?.Product?.Name <small class="text-muted">@r.ProductUnit?.SerialNumber</small></td>
                        <td>@r.CreatedAt.ToLocalTime().ToString("dd.MM.yy HH:mm")</td>
                        <td><span class="badge bg-@badge">@r.Status</span></td>
                        <td><a href="/admin/rentals/@r.Id" class="btn btn-xs btn-outline-primary btn-sm">→</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-white">
        <a href="/admin/rentals" class="text-decoration-none small">Все аренды →</a>
    </div>
</div>
