@model IEnumerable<Product>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Товары";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">📦 Товары</h4>
    <a href="/admin/products/create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>Добавить товар
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Название</th>
                    <th>Категория</th>
                    <th>Цена/ч</th>
                    <th>Залог</th>
                    <th>Всего / Свободно</th>
                    <th>Статус</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    var available = p.Units.Count(u => u.Status == UnitStatus.Available);
                    <tr>
                        <td class="text-muted small">@p.Id</td>
                        <td class="fw-semibold">@p.Name</td>
                        <td><span class="badge bg-secondary">@p.Category.Name</span></td>
                        <td>@p.PricePerHour ₽</td>
                        <td>@p.DepositAmount ₽</td>
                        <td>
                            @p.Units.Count / <span class="text-success fw-bold">@available</span>
                        </td>
                        <td>
                            @if (p.IsActive)
                            {
                                <span class="badge bg-success">Активен</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Скрыт</span>
                            }
                        </td>
                        <td class="text-end">
                            <a href="/admin/products/units/@p.Id" class="btn btn-sm btn-outline-secondary">Экземпляры</a>
                            <a href="/admin/products/edit/@p.Id" class="btn btn-sm btn-outline-primary ms-1">Ред.</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
