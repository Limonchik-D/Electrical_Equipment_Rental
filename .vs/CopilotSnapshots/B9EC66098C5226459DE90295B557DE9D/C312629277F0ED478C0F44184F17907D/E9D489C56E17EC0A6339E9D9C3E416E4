@{
    ViewData["Title"] = "Карта точек проката";
}

<h2 class="mb-3">@ViewData["Title"]</h2>

<div class="mb-3 d-flex gap-3 flex-wrap">
    <span><span style="color:#28a745">●</span> Точка проката</span>
    <span><span style="color:#007bff">●</span> Свободная техника</span>
    <span><span style="color:#dc3545">●</span> Техника в аренде</span>
    <span><span style="color:#ffc107">●</span> Техника в ремонте</span>
</div>

<div id="map" style="height:500px; border-radius:8px;"></div>

@section Scripts {
<script>
    var map = L.map('map').setView([47.7631, 29.6383], 13);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
    }).addTo(map);

    // Функция создания цветного маркера
    function coloredIcon(color) {
        return L.divIcon({
            className: '',
            html: '<div style="width:16px;height:16px;border-radius:50%;background:' + color + ';border:2px solid #fff;box-shadow:0 0 4px rgba(0,0,0,.4);"></div>',
            iconSize: [16, 16],
            iconAnchor: [8, 8],
            popupAnchor: [0, -10]
        });
    }

    // Точка проката (зелёный)
    L.marker([47.7631, 29.6383], { icon: coloredIcon('#28a745') })
        .addTo(map)
        .bindPopup('<b>Точка проката №1</b><br>ул. Центральная, 5');

    // Свободная техника (синий)
    L.marker([47.7650, 29.6410], { icon: coloredIcon('#007bff') })
        .addTo(map)
        .bindPopup('<b>Электросамокат #SN-001</b><br>Статус: свободен');

    // Техника в аренде (красный)
    L.marker([47.7615, 29.6355], { icon: coloredIcon('#dc3545') })
        .addTo(map)
        .bindPopup('<b>Электровелосипед #SN-042</b><br>Статус: в аренде');

    // Техника в ремонте (жёлтый)
    L.marker([47.7600, 29.6420], { icon: coloredIcon('#ffc107') })
        .addTo(map)
        .bindPopup('<b>Электроскутер #SN-017</b><br>Статус: ремонт');
</script>
}
