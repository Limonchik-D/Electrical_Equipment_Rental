@model IEnumerable<Category>
@{
    ViewData["Title"] = "Прокат электротехники";
}

<!-- Hero -->
<div class="hero-section mb-5 fade-in-up">
    <div class="row align-items-center">
        <div class="col-lg-7" style="position:relative;z-index:1">
            <div class="d-flex align-items-center gap-2 mb-3">
                <span class="badge-accent px-3 py-1 rounded-pill" style="background:rgba(99,102,241,.15);color:var(--accent-hover);font-size:.78rem;font-weight:700;letter-spacing:.05em;">
                    ⚡ ЭЛЕКТРО-ПРОКАТ
                </span>
            </div>
            <h1 class="hero-title mb-3">Бери в аренду.<br/>Езди без забот.</h1>
            <p class="hero-subtitle mb-4 col-md-10">
                Самокаты, велосипеды, скутеры — оформление за 2 минуты.
                Несколько точек выдачи в городе.
            </p>
            <div class="d-flex flex-wrap gap-3">
                <a class="btn-accent btn px-4 py-2 d-flex align-items-center gap-2"
                   asp-controller="Catalog" asp-action="Index">
                    <i class="bi bi-grid-3x3-gap"></i> Смотреть каталог
                </a>
                <a class="btn-outline-accent btn px-4 py-2 d-flex align-items-center gap-2"
                   asp-controller="Home" asp-action="Map">
                    <i class="bi bi-geo-alt"></i> Карта точек
                </a>
            </div>
        </div>
        <div class="col-lg-5 d-none d-lg-flex justify-content-end align-items-center" style="position:relative;z-index:1">
            <div style="font-size:9rem;filter:drop-shadow(0 0 40px rgba(99,102,241,.5));line-height:1;">⚡</div>
        </div>
    </div>
</div>

<!-- Features -->
<div class="row g-4 mb-5">
    <div class="col-md-4 fade-in-up">
        <div class="card-dark p-4 h-100 d-flex gap-3">
            <div style="width:44px;height:44px;background:rgba(34,197,94,.12);border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="bi bi-shield-check" style="color:#22c55e;font-size:1.2rem;"></i>
            </div>
            <div>
                <h6 class="fw-700 mb-1" style="color:var(--text-primary)">Надёжно</h6>
                <p class="mb-0" style="color:var(--text-secondary);font-size:.875rem;">Вся техника проверена, застрахована и готова к выдаче</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 fade-in-up">
        <div class="card-dark p-4 h-100 d-flex gap-3">
            <div style="width:44px;height:44px;background:rgba(99,102,241,.15);border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="bi bi-geo-alt" style="color:var(--accent);font-size:1.2rem;"></i>
            </div>
            <div>
                <h6 class="fw-700 mb-1" style="color:var(--text-primary)">Удобно</h6>
                <p class="mb-0" style="color:var(--text-secondary);font-size:.875rem;">Несколько точек выдачи в городе, смотри на карте</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 fade-in-up">
        <div class="card-dark p-4 h-100 d-flex gap-3">
            <div style="width:44px;height:44px;background:rgba(245,158,11,.12);border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="bi bi-lightning-charge" style="color:#f59e0b;font-size:1.2rem;"></i>
            </div>
            <div>
                <h6 class="fw-700 mb-1" style="color:var(--text-primary)">Быстро</h6>
                <p class="mb-0" style="color:var(--text-secondary);font-size:.875rem;">Оформление за 2 минуты, без очередей и лишних документов</p>
            </div>
        </div>
    </div>
</div>

<!-- Categories -->
<div class="mb-2 d-flex align-items-center justify-content-between">
    <h4 class="fw-800 mb-0" style="color:var(--text-primary)">Категории техники</h4>
    <a asp-controller="Catalog" asp-action="Index" class="text-decoration-none d-flex align-items-center gap-1"
       style="color:var(--text-secondary);font-size:.875rem;">
        Весь каталог <i class="bi bi-arrow-right"></i>
    </a>
</div>
<div class="row row-cols-2 row-cols-md-4 g-3 mb-5">
    @foreach (var cat in Model)
    {
        <div class="col fade-in-up">
            <a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="@cat.Id" class="category-card">
                <i class="bi @cat.IconClass cat-icon"></i>
                <div class="cat-name">@cat.Name</div>
                <div class="cat-desc">@cat.Description</div>
                <span class="mt-2 d-inline-block px-2 py-1 rounded-pill"
                      style="background:rgba(99,102,241,.12);color:var(--accent-hover);font-size:.72rem;font-weight:600;">
                    @cat.Products.Count(p => p.IsActive) товаров
                </span>
            </a>
        </div>
    }
</div>

<!-- CTA -->
<div class="card-dark p-4 p-md-5 text-center fade-in-up"
     style="background:linear-gradient(135deg,#1e1b4b,#1e293b);border-color:rgba(99,102,241,.3);">
    <h4 class="fw-800 mb-2" style="color:var(--text-primary)">Готов поехать?</h4>
    <p style="color:var(--text-secondary)" class="mb-4">Зарегистрируйся и выбери технику прямо сейчас</p>
    <div class="d-flex justify-content-center gap-3 flex-wrap">
        <a href="/account/register" class="btn-accent btn px-4 py-2">Создать аккаунт</a>
        <a asp-controller="Catalog" asp-action="Index" class="btn-outline-accent btn px-4 py-2">Смотреть каталог</a>
    </div>
</div>

