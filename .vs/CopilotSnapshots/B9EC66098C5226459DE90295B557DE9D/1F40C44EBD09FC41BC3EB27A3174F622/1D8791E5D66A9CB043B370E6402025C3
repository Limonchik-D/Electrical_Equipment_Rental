@model Location
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Новая точка стоянки";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a href="/admin/locations" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
    <h4 class="mb-0">Добавить точку стоянки</h4>
</div>

<div class="row g-4">
    <div class="col-md-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Название</label>
                        <input asp-for="Name" class="form-control" placeholder="Центральная точка" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label fw-semibold">Адрес</label>
                        <input asp-for="Address" class="form-control" placeholder="ул. Примерная, 1" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col">
                            <label asp-for="Latitude" class="form-label fw-semibold">Широта</label>
                            <input asp-for="Latitude" id="latInput" class="form-control" type="number" step="0.000001" />
                            <span asp-validation-for="Latitude" class="text-danger small"></span>
                        </div>
                        <div class="col">
                            <label asp-for="Longitude" class="form-label fw-semibold">Долгота</label>
                            <input asp-for="Longitude" id="lngInput" class="form-control" type="number" step="0.000001" />
                            <span asp-validation-for="Longitude" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4 form-check">
                        <input asp-for="IsActive" class="form-check-input" checked />
                        <label asp-for="IsActive" class="form-check-label">Активна</label>
                    </div>

                    <p class="text-muted small"><i class="bi bi-cursor me-1"></i>Кликните на карту справа для выбора координат</p>
                    <button type="submit" class="btn btn-primary w-100">Сохранить точку</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div id="pickMap" style="height:420px; border-radius:10px; box-shadow:0 2px 8px rgba(0,0,0,.12);"></div>
    </div>
</div>

@section Scripts {
<script>
    var marker = null;
    var map = L.map('pickMap').setView([47.7631, 29.6383], 13);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap' }).addTo(map);

    map.on('click', function(e) {
        var lat = e.latlng.lat.toFixed(6);
        var lng = e.latlng.lng.toFixed(6);
        document.getElementById('latInput').value = lat;
        document.getElementById('lngInput').value = lng;
        if (marker) marker.remove();
        marker = L.marker([lat, lng]).addTo(map).bindPopup('Выбранная точка').openPopup();
    });
</script>
}
