@model IEnumerable<Rental>
@{
    ViewData["Title"] = "Мои аренды";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Мои аренды</h2>
    <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Новая аренда
    </a>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-calendar-x fs-1 text-muted"></i>
            <p class="mt-3 text-muted">У вас пока нет аренд.</p>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary">Перейти в каталог</a>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var rental in Model)
        {
            var statusClass = rental.Status switch
            {
                RentalStatus.Pending => "warning",
                RentalStatus.Active => "success",
                RentalStatus.Completed => "secondary",
                RentalStatus.Cancelled => "danger",
                _ => "secondary"
            };
            var statusLabel = rental.Status switch
            {
                RentalStatus.Pending => "Ожидает подтверждения",
                RentalStatus.Active => "Активна",
                RentalStatus.Completed => "Завершена",
                RentalStatus.Cancelled => "Отменена",
                _ => rental.Status.ToString()
            };

            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <div class="fw-bold fs-5">@rental.ProductUnit.Product.Name</div>
                                <small class="text-muted">S/N: @rental.ProductUnit.SerialNumber</small>
                                <div class="mt-1">
                                    <i class="bi bi-geo-alt text-muted me-1"></i>
                                    <small>@rental.StartLocation?.Name</small>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-muted small">Оформлено</div>
                                <div>@rental.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                                @if (rental.PlannedEndAt.HasValue)
                                {
                                    <div class="text-muted small mt-1">Вернуть до</div>
                                    <div>@rental.PlannedEndAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                                }
                            </div>
                            <div class="col-md-3 text-end">
                                <span class="badge bg-@statusClass fs-6 mb-2">@statusLabel</span>
                                @if (rental.TotalAmount.HasValue)
                                {
                                    <div class="fw-bold">Итого: @rental.TotalAmount ₽</div>
                                }
                                @if (rental.FineAmount.HasValue && rental.FineAmount > 0)
                                {
                                    <div class="text-danger small">Штраф: @rental.FineAmount ₽</div>
                                }
                                @if (rental.Status == RentalStatus.Pending)
                                {
                                    <form asp-action="Cancel" method="post" class="mt-2"
                                          onsubmit="return confirm('Отменить аренду?')">
                                        <input type="hidden" name="id" value="@rental.Id" />
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Отменить</button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
