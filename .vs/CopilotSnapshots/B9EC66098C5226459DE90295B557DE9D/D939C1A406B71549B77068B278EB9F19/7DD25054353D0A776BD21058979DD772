@model IEnumerable<Category>
@{
    ViewData["Title"] = "Прокат электротехники";
}

<div class="p-5 mb-4 bg-dark text-white rounded-3">
    <div class="container-fluid py-3">
        <h1 class="display-5 fw-bold">⚡ Прокат электротехники</h1>
        <p class="col-md-8 fs-4">Самокаты, велосипеды, скутеры — бери в аренду на любое время.</p>
        <a class="btn btn-primary btn-lg" asp-controller="Catalog" asp-action="Index">Смотреть каталог</a>
        <a class="btn btn-outline-light btn-lg ms-2" asp-controller="Home" asp-action="Map">Карта точек</a>
    </div>
</div>

<h3 class="mb-4">Категории</h3>
<div class="row row-cols-1 row-cols-md-4 g-4 mb-5">
    @foreach (var cat in Model)
    {
        <div class="col">
            <a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="@cat.Id" class="text-decoration-none">
                <div class="card h-100 text-center shadow-sm border-0 hover-shadow">
                    <div class="card-body">
                        <i class="bi @cat.IconClass fs-1 text-primary mb-2"></i>
                        <h5 class="card-title">@cat.Name</h5>
                        <p class="card-text text-muted small">@cat.Description</p>
                        <span class="badge bg-secondary">@cat.Products.Count(p => p.IsActive) товаров</span>
                    </div>
                </div>
            </a>
        </div>
    }
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="d-flex align-items-start">
            <i class="bi bi-shield-check fs-2 text-success me-3"></i>
            <div>
                <h5>Надёжно</h5>
                <p class="text-muted">Вся техника проверена и застрахована</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="d-flex align-items-start">
            <i class="bi bi-geo-alt fs-2 text-primary me-3"></i>
            <div>
                <h5>Удобно</h5>
                <p class="text-muted">Несколько точек выдачи в городе</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="d-flex align-items-start">
            <i class="bi bi-clock fs-2 text-warning me-3"></i>
            <div>
                <h5>Быстро</h5>
                <p class="text-muted">Оформление за 2 минуты</p>
            </div>
        </div>
    </div>
</div>
