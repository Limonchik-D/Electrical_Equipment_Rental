<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Панель управления — @ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
</head>
<body>
<div class="d-flex">
    <!-- Sidebar -->
    <div class="admin-sidebar-dark p-3">
        <a href="/" class="text-decoration-none d-flex align-items-center gap-2 mb-4 pb-3"
           style="border-bottom:1px solid var(--border);">
            <span style="width:32px;height:32px;background:var(--accent);border-radius:8px;display:inline-flex;align-items:center;justify-content:center;font-size:.9rem;flex-shrink:0;">⚡</span>
            <span style="color:var(--text-primary);font-weight:800;font-size:1rem;">EL-Rent</span>
        </a>

        <p style="color:var(--text-secondary);font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;padding:.2rem .5rem;margin-bottom:.5rem;">Управление</p>

        <nav class="d-flex flex-column gap-1">
            <a href="/admin" class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminDashboard" ? "active" : "")">
                <i class="bi bi-speedometer2"></i>Дашборд
            </a>
            <a href="/admin/products" class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminProduct" ? "active" : "")">
                <i class="bi bi-box-seam"></i>Товары
            </a>
            <a href="/admin/rentals" class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminRental" ? "active" : "")">
                <i class="bi bi-calendar-check"></i>Аренды
            </a>
            <a href="/admin/repairs" class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminRepair" ? "active" : "")">
                <i class="bi bi-tools"></i>Ремонты
            </a>
            <a href="/admin/locations" class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminLocation" ? "active" : "")">
                <i class="bi bi-geo-alt"></i>Точки стоянки
            </a>
            <a href="/admin/users" class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminUser" ? "active" : "")">
                <i class="bi bi-people"></i>Пользователи
            </a>
        </nav>

        <div class="mt-auto pt-3" style="border-top:1px solid var(--border);margin-top:auto;">
            <a href="/" class="admin-nav-link">
                <i class="bi bi-arrow-left"></i>На сайт
            </a>
        </div>
    </div>

    <!-- Content -->
    <div class="admin-content-dark flex-grow-1 p-4">
        @if (TempData["Success"] is string success)
        {
            <div class="alert-dark-success p-3 rounded-custom mb-3 d-flex align-items-center gap-2 alert-dismissible fade show">
                <i class="bi bi-check-circle-fill"></i>
                <span>@success</span>
                <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert-dark-danger p-3 rounded-custom mb-3 d-flex align-items-center gap-2 alert-dismissible fade show">
                <i class="bi bi-exclamation-circle-fill"></i>
                <span>@error</span>
                <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }
        <main>@RenderBody()</main>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

