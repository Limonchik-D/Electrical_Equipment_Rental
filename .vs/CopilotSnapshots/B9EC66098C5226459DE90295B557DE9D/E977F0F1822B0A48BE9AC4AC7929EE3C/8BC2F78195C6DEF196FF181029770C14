@using System.Text.Json
@model IEnumerable<Location>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Точки стоянки";
    var jsonOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var locJson = JsonSerializer.Serialize(
        Model.Select(l => new { l.Id, l.Name, l.Address, l.Latitude, l.Longitude, l.IsActive }),
        jsonOpts);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-800 mb-0" style="color:var(--text-primary)">Точки стоянки</h4>
        <p class="mb-0 text-secondary-custom" style="font-size:.875rem;">@Model.Count() точек</p>
    </div>
    <a href="/admin/locations/create" class="btn-accent btn px-4 d-flex align-items-center gap-2">
        <i class="bi bi-plus-lg"></i>Добавить точку
    </a>
</div>

<div class="row g-4">
    <div class="col-md-5">
        <div class="card-dark overflow-hidden">
            <div class="table-responsive">
                <table class="table-dark-custom table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Название</th>
                            <th>Техники</th>
                            <th>Статус</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var loc in Model)
                        {
                            <tr>
                                <td>
                                    <div style="color:var(--text-primary);font-weight:600;">@loc.Name</div>
                                    <div style="color:var(--text-secondary);font-size:.78rem;">@loc.Address</div>
                                </td>
                                <td style="color:var(--text-primary);">@loc.Units.Count</td>
                                <td>
                                    @if (loc.IsActive)
                                    {
                                        <span class="px-2 py-1 rounded-pill" style="background:rgba(34,197,94,.12);color:#86efac;font-size:.75rem;font-weight:600;">Активна</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-1 rounded-pill" style="background:rgba(148,163,184,.1);color:var(--text-secondary);font-size:.75rem;font-weight:600;">Скрыта</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a href="/admin/locations/edit/@loc.Id"
                                       style="background:rgba(99,102,241,.12);color:var(--accent);border-radius:6px;padding:.3rem .65rem;text-decoration:none;font-size:.8rem;font-weight:600;margin-right:.3rem;display:inline-block;">Ред.</a>
                                    <form asp-action="Delete" asp-route-id="@loc.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Скрыть точку?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                style="background:transparent;color:#fca5a5;border:1px solid rgba(239,68,68,.3);border-radius:6px;padding:.25rem .6rem;font-size:.8rem;cursor:pointer;">✕</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div id="adminMap" style="height:420px;border-radius:var(--radius);border:1px solid var(--border);"></div>
    </div>
</div>

@section Scripts {
<script>
    var map = L.map('adminMap').setView([47.7631, 29.6383], 13);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap'
    }).addTo(map);

    var locations = @Html.Raw(locJson);
    locations.forEach(function(loc) {
        L.marker([loc.latitude, loc.longitude])
            .addTo(map)
            .bindPopup('<b>📍 ' + loc.name + '</b><br>' + loc.address +
                (loc.isActive ? '' : '<br><em>Скрыта</em>'));
    });
</script>
}
